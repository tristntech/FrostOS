# FrostOS window manager defaults.
[org.kde.kdecoration2]
# Close, minimize, maximize on the left of the title bar.
ButtonsOnLeft=XIA
ButtonsOnRight=

[Plugins]
blurEnabled=true
contrastEnabled=true
magiclampEnabled=true
squashEnabled=false

[Effect-blur]
BlurStrength=10
NoiseStrength=0

[Desktops]
Number=4
Rows=1

[Windows]
ElectricBorderMaximize=true
ElectricBorderTiling=true
