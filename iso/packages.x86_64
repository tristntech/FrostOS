# Packages FrostOS adds on top of Arch's releng package list (the official Arch ISO).
# One package per line. Lines starting with # are comments.
# Packages marked (AUR) are built by scripts/build-aur.sh; see aur-packages.txt.

# --- Desktop: KDE Plasma 6 on Wayland ---
plasma-desktop
kscreen
plasma-nm
plasma-pa
bluedevil
powerdevil
power-profiles-daemon
kinfocenter
kde-gtk-config
breeze-gtk
xdg-desktop-portal-kde
polkit-kde-agent
appmenu-gtk-module
ocean-sound-theme
sddm
sddm-kcm

# --- Frost apps (KDE apps with FrostOS names and themes) ---
dolphin
konsole
discover
packagekit-qt6
flatpak
flatpak-kcm
archlinux-appstream-data

# --- Browser ---
