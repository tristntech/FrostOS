# Packages FrostOS adds on top of Arch's releng package list (the official Arch ISO).
# One package per line. Lines starting with # are comments.
# AUR packages (see aur-packages.txt) are built during the ISO build.

# --- FrostDE: Hyprland draws the windows, Quickshell runs the FrostDE shell ---
hyprland
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
hyprpolkitagent
hyprlock
quickshell
qt6-wayland
qt6-svg
qt6-imageformats
greetd
greetd-agreety

# --- Frost Settings (Python + GTK 4 + libadwaita) ---
python
python-gobject
gtk4
libadwaita

# --- Apps ---
nautilus                  # Frost Files
ptyxis                    # Frost Terminal
gnome-software            # Frost Store
packagekit
flatpak
archlinux-appstream-data
gnome-text-editor
gnome-calculator
gnome-clocks
gnome-system-monitor
loupe
showtime
papers
file-roller
gvfs
brave-bin                 # (AUR) official Brave package, maintained by Brave

# --- Look ---
adw-gtk-theme
adwaita-icon-theme
whitesur-icon-theme       # (AUR) macOS-style icons
inter-font
noto-fonts
noto-fonts-emoji
ttf-jetbrains-mono
ttf-nerd-fonts-symbols

