        version.add_css_class("dim-label")
        box.append(version)
        head.add(box)

        group = Adw.PreferencesGroup(title="This Computer")
        self.add(group)
        group.add(info_row("Processor", self.cpu()))
        group.add(info_row("Memory", self.memory()))
        group.add(info_row("Graphics", self.graphics()))
        group.add(info_row("Disk", self.disk()))
        group.add(info_row("Desktop", "FrostDE on Hyprland (Wayland)"))
        group.add(info_row("Kernel", os.uname().release))

    @staticmethod
    def version():
        release = read_file("/etc/frostos-release").strip()
        return release or "Rolling release"

    @staticmethod
    def cpu():
        m = re.search(r"model name\s*:\s*(.+)", read_file("/proc/cpuinfo"))
        cores = os.cpu_count() or 1
        return f"{m.group(1).strip() if m else 'Unknown'}  ({cores} cores)"

    @staticmethod
    def memory():
        m = re.search(r"MemTotal:\s*(\d+)", read_file("/proc/meminfo"))
        return f"{int(m.group(1)) / 1024 / 1024:.1f} GB" if m else "Unknown"

    @staticmethod
    def graphics():
        code, out = run(["lspci"])
        cards = [line.split(": ", 1)[1] for line in out.splitlines()
                 if re.search(r"VGA|3D|Display", line) and ": " in line]
        return ", ".join(cards) or "Unknown"

    @staticmethod
    def disk():
        st = os.statvfs("/")
        return human_size(st.f_blocks * st.f_frsize)


