            provider.load_from_string(f"button {{ background: {color}; }}"
                                      + ("button { outline: 2px solid alpha(currentColor, 0.6); outline-offset: 2px; }"
                                         if color.lower() == current else ""))
            button.get_style_context().add_provider(provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            button.connect("clicked", self.on_accent, name, color, gnome, gtk_bg, gtk_fg)
