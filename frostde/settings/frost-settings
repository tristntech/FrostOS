class BatteryPage(Page):
    PROFILES = [("power-saver", "Low Power"), ("balanced", "Balanced"), ("performance", "High Performance")]

    def __init__(self):
        super().__init__()
        group = Adw.PreferencesGroup(title="Battery")
        self.add(group)
        _, out = run(["upower", "-i", "/org/freedesktop/UPower/devices/DisplayDevice"])
        pct = re.search(r"percentage:\s*([\d.]+)%", out)
        state = re.search(r"state:\s*(\S+)", out)
        present = re.search(r"is-present:\s*yes", out)
        if present and pct:
            group.add(info_row("Charge", f"{float(pct.group(1)):.0f}%"))
            group.add(info_row("Status", (state.group(1) if state else "unknown").replace("-", " ").capitalize()))
        else:
            group.add(Adw.ActionRow(title="No battery", subtitle="This computer runs on mains power."))

        power = Adw.PreferencesGroup(title="Energy Mode")
        self.add(power)
        if not have("powerprofilesctl"):
            power.add(Adw.ActionRow(title="Power profiles are not available."))
            return
        _, current = run(["powerprofilesctl", "get"])
        current = current.strip()
        _, available = run(["powerprofilesctl", "list"])
        profiles = [p for p in self.PROFILES if p[0] in available] or self.PROFILES[1:2]
        row = Adw.ComboRow(title="Energy mode")
        row.set_model(Gtk.StringList.new([label for _, label in profiles]))
        ids = [p for p, _ in profiles]
        if current in ids:
            row.set_selected(ids.index(current))
        row.connect("notify::selected", lambda r, *_: run_async(
            ["powerprofilesctl", "set", ids[r.get_selected()]]))
        power.add(row)


