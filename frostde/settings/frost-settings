class SoundPage(Page):
    def __init__(self):
        super().__init__()
        self.group = Adw.PreferencesGroup(title="Output")
        self.add(self.group)
        if not have("pactl"):
            self.group.add(Adw.ActionRow(title="Sound tools (pactl) are not installed."))
            return

        self.volume_row = Adw.ActionRow(title="Volume")
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale.set_hexpand(True)
        self.scale.set_size_request(260, -1)
        self.scale.set_valign(Gtk.Align.CENTER)
        self.volume_row.add_suffix(self.scale)
        self.group.add(self.volume_row)

        self.mute = Adw.SwitchRow(title="Mute")
        self.group.add(self.mute)

        self.devices = Adw.ComboRow(title="Output device")
        self.group.add(self.devices)

        self.sinks = []
        self.updating = False
        self.scale.connect("value-changed", self.on_volume)
        self.mute.connect("notify::active", self.on_mute)
        self.devices.connect("notify::selected", self.on_device)
        self.refresh()

    def refresh(self):
        run_async(["pactl", "-f", "json", "list", "sinks"], self.got_sinks)

    def got_sinks(self, code, out):
        try:
            sinks = json.loads(out) if code == 0 else []
        except ValueError:
            sinks = []
        _, default = run(["pactl", "get-default-sink"])
        default = default.strip()
        self.updating = True
        self.sinks = sinks
        names = [s.get("description") or s.get("name", "Unknown") for s in sinks]
        self.devices.set_model(Gtk.StringList.new(names or ["No output devices"]))
        for i, s in enumerate(sinks):
            if s.get("name") == default:
                self.devices.set_selected(i)
                vol = s.get("volume", {})
                first = next(iter(vol.values()), {}) if isinstance(vol, dict) else {}
                percent = str(first.get("value_percent", "0%")).rstrip("%")
                self.scale.set_value(float(percent) if percent.replace(".", "").isdigit() else 0)
                self.mute.set_active(bool(s.get("mute")))
        self.updating = False

    def on_volume(self, scale):
        if not self.updating:
            run_async(["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{int(scale.get_value())}%"])

    def on_mute(self, *_):
        if not self.updating:
            run_async(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "1" if self.mute.get_active() else "0"])

    def on_device(self, *_):
        i = self.devices.get_selected()
        if not self.updating and 0 <= i < len(self.sinks):
            run_async(["pactl", "set-default-sink", self.sinks[i]["name"]], lambda *_: self.refresh())


# ---- Displays ----------------------------------------------------------------

class DisplaysPage(Page):
    SCALES = ["1", "1.25", "1.5", "1.75", "2"]

    def __init__(self):
        super().__init__()
        code, out = run(["hyprctl", "monitors", "-j"])
        try:
            self.monitors = json.loads(out) if code == 0 else []
        except ValueError:
            self.monitors = []
        if not self.monitors:
            group = Adw.PreferencesGroup()
            group.add(Adw.ActionRow(title="Display settings work inside FrostDE only."))
            self.add(group)
            return
        self.rows = {}
        for mon in self.monitors:
            self.add_monitor(mon)
        note = Adw.PreferencesGroup(description="Changes apply right away and are kept after a restart.")
        self.add(note)

    def add_monitor(self, mon):
        name = mon.get("name", "?")
        title = " ".join(x for x in (mon.get("make"), mon.get("model")) if x) or name
        group = Adw.PreferencesGroup(title=title, description=name)
        self.add(group)

        modes = []
        for m in mon.get("availableModes", []):
            mm = re.match(r"(\d+)x(\d+)@([\d.]+)Hz", m)
            if mm:
                label = f"{mm.group(1)} × {mm.group(2)}  ({float(mm.group(3)):.0f} Hz)"
                modes.append((m.replace("Hz", ""), label))
        current = f"{mon.get('width')}x{mon.get('height')}@{mon.get('refreshRate', 60):.3f}"
        res = Adw.ComboRow(title="Resolution")
        res.set_model(Gtk.StringList.new([label for _, label in modes] or ["Automatic"]))
        best = 0
        for i, (mode, _) in enumerate(modes):
            if mode.split("@")[0] == current.split("@")[0]:
                best = i
                break
        res.set_selected(best)
        group.add(res)

        scale = Adw.ComboRow(title="Scale", subtitle="Makes text and windows bigger")
        scale.set_model(Gtk.StringList.new([f"{float(s) * 100:.0f}%" for s in self.SCALES]))
        cur_scale = float(mon.get("scale", 1))
        scale.set_selected(min(range(len(self.SCALES)), key=lambda i: abs(float(self.SCALES[i]) - cur_scale)))
        group.add(scale)

        self.rows[name] = (res, scale, modes)
        res.connect("notify::selected", lambda *_: self.apply())
        scale.connect("notify::selected", lambda *_: self.apply())

    def apply(self):
        lines = ["-- Written by Frost Settings > Displays.", ""]
        for mon in self.monitors:
            name = mon.get("name")
            if name not in self.rows:
                continue
            res, scale, modes = self.rows[name]
            mode = modes[res.get_selected()][0] if modes else "preferred"
            s = self.SCALES[scale.get_selected()]
            lua = (f"hl.monitor({{ output = {lua_string(name)}, mode = {lua_string(mode)}, "
                   f"position = \"auto\", scale = {s} }})")
            lines.append(lua)
            hypr_eval(lua)
        write_text(os.path.join(CONFIG_DIR, "monitors.lua"), "\n".join(lines) + "\n")


