# ---- Wi-Fi -------------------------------------------------------------------

class WifiPage(Page):
    def __init__(self):
        super().__init__()
        if not have("nmcli"):
            self.add_group_message("NetworkManager is not installed.")
            return

        self.top = Adw.PreferencesGroup()
        self.add(self.top)
        self.switch = Adw.SwitchRow(title="Wi-Fi")
        self.top.add(self.switch)
        self.current = Adw.ActionRow(title="Not connected")
        self.top.add(self.current)

        self.networks = Adw.PreferencesGroup(title="Other Networks")
        self.scan_button = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Look for networks")
        self.scan_button.add_css_class("flat")
        self.scan_button.connect("clicked", lambda *_: self.refresh(rescan=True))
        self.networks.set_header_suffix(self.scan_button)
        self.add(self.networks)
        self.network_rows = []

        self.wired = Adw.PreferencesGroup(title="Ethernet")
        self.add(self.wired)
        self.wired_row = Adw.ActionRow(title="Ethernet")
        self.wired.add(self.wired_row)

        self.updating = False
        self.switch.connect("notify::active", self.on_switch)
        self.refresh()

    def add_group_message(self, text):
        group = Adw.PreferencesGroup()
        group.add(Adw.ActionRow(title=text))
        self.add(group)

    def on_switch(self, *_):
        if self.updating:
            return
        on = self.switch.get_active()
        run_async(["nmcli", "radio", "wifi", "on" if on else "off"],
                  lambda *_: GLib.timeout_add(1500, lambda: (self.refresh(), False)[1]))

    def refresh(self, rescan=False):
        run_async(["nmcli", "-t", "-f", "TYPE,STATE,CONNECTION", "device"], self.got_devices)
        run_async(["nmcli", "radio", "wifi"], self.got_radio)
        cmd = ["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi", "list"]
        if rescan:
            cmd += ["--rescan", "yes"]
        run_async(cmd, self.got_networks)

    @staticmethod
    def split(line):
        return [p.replace("\x01", ":") for p in line.replace("\\:", "\x01").split(":")]

    def got_radio(self, code, out):
        self.updating = True
        self.switch.set_active(out.strip() == "enabled")
        self.updating = False

    def got_devices(self, code, out):
        has_wifi = False
        wired = None
        for line in out.splitlines():
            parts = self.split(line)
            if len(parts) < 3:
                continue
            if parts[0] == "wifi":
                has_wifi = True
                if parts[1] == "connected":
                    self.current.set_title(parts[2])
                    self.current.set_subtitle("Connected")
            elif parts[0] == "ethernet":
                wired = parts
        self.switch.set_sensitive(has_wifi)
        if not has_wifi:
            self.current.set_title("No Wi-Fi hardware found")
            self.current.set_subtitle("This computer has no Wi-Fi adapter, or it is not supported.")
        self.wired.set_visible(wired is not None)
        if wired:
            self.wired_row.set_subtitle("Connected" if wired[1] == "connected" else "Not connected")

    def got_networks(self, code, out):
        for row in self.network_rows:
            self.networks.remove(row)
        self.network_rows = []
        seen = set()
        for line in out.splitlines():
            parts = self.split(line)
            if len(parts) < 4 or not parts[1] or parts[1] in seen:
                continue
            in_use, ssid, signal, security = parts[0] == "*", parts[1], parts[2], parts[3]
            seen.add(ssid)
            if in_use:
                self.current.set_title(ssid)
                self.current.set_subtitle("Connected")
                continue
            strength = int(signal) if signal.isdigit() else 0
            icon = ("network-wireless-signal-excellent-symbolic" if strength > 75 else
                    "network-wireless-signal-good-symbolic" if strength > 50 else
                    "network-wireless-signal-ok-symbolic" if strength > 25 else
                    "network-wireless-signal-weak-symbolic")
            row = Adw.ActionRow(title=ssid, subtitle="Secured" if security not in ("", "--") else "Open")
            row.add_suffix(Gtk.Image.new_from_icon_name(icon))
            row.set_activatable(True)
            row.connect("activated", self.on_network, ssid, security not in ("", "--"))
            self.networks.add(row)
            self.network_rows.append(row)
        if not self.network_rows:
            row = Adw.ActionRow(title="No other networks found")
            self.networks.add(row)
            self.network_rows.append(row)

    def on_network(self, row, ssid, secured):
        if not secured:
            self.connect_to(ssid, None)
            return
        dialog = Adw.AlertDialog(heading=f"Join “{ssid}”", body="Enter the Wi-Fi password.")
        entry = Adw.PasswordEntryRow(title="Password")
        box = Gtk.ListBox()
        box.add_css_class("boxed-list")
        box.append(entry)
        dialog.set_extra_child(box)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("join", "Join")
        dialog.set_response_appearance("join", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("join")

        def on_response(d, response):
            if response == "join":
                self.connect_to(ssid, entry.get_text())
        dialog.connect("response", on_response)
        dialog.present(self.get_root())

    def connect_to(self, ssid, password):
        toast(self, f"Joining {ssid}…")
        cmd = ["nmcli", "device", "wifi", "connect", ssid]
        if password:
            cmd += ["password", password]

        def done(code, out):
            toast(self, f"Connected to {ssid}" if code == 0 else f"Couldn't join {ssid}. Check the password.")
            self.refresh()
        run_async(cmd, done, timeout=45)


# ---- Bluetooth ---------------------------------------------------------------

class BluetoothPage(Page):
    def __init__(self):
        super().__init__()
        self.group = Adw.PreferencesGroup()
        self.add(self.group)
        if not have("bluetoothctl"):
            self.group.add(Adw.ActionRow(title="Bluetooth tools are not installed."))
            return
        self.switch = Adw.SwitchRow(title="Bluetooth")
        self.group.add(self.switch)
        self.state = Adw.ActionRow(title="Checking…")
        self.group.add(self.state)

        self.devices = Adw.PreferencesGroup(title="Devices")
        scan = Gtk.Button(label="Search", tooltip_text="Look for nearby devices for 10 seconds")
        scan.add_css_class("flat")
        scan.connect("clicked", self.on_scan)
        self.devices.set_header_suffix(scan)
        self.add(self.devices)
        self.device_rows = []

        self.updating = False
        self.switch.connect("notify::active", self.on_switch)
        self.refresh()

    def refresh(self):
        run_async(["bluetoothctl", "show"], self.got_show)
        run_async(["bluetoothctl", "devices"], self.got_devices)

    def got_show(self, code, out):
        if code != 0 or "Controller" not in out:
            self.switch.set_sensitive(False)
            self.state.set_title("No Bluetooth adapter found")
            self.state.set_subtitle("This computer has no Bluetooth, or it is turned off in the BIOS.")
            self.devices.set_visible(False)
            return
        powered = re.search(r"Powered:\s*yes", out) is not None
        self.updating = True
        self.switch.set_active(powered)
        self.updating = False
        name = re.search(r"Alias:\s*(.+)", out)
        self.state.set_title("Now discoverable as “%s”" % name.group(1).strip() if name and powered else
                             "Bluetooth is off")
        self.devices.set_visible(powered)

    def got_devices(self, code, out):
        for row in self.device_rows:
            self.devices.remove(row)
        self.device_rows = []
        for line in out.splitlines():
            m = re.match(r"Device\s+([0-9A-F:]{17})\s+(.*)", line.strip())
            if not m:
                continue
            address, name = m.group(1), m.group(2)
            row = Adw.ActionRow(title=name, subtitle=address)
            button = Gtk.Button(label="Connect", valign=Gtk.Align.CENTER)
            button.connect("clicked", self.on_connect, address, name)
            row.add_suffix(button)
            forget = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER, tooltip_text="Forget")
            forget.add_css_class("flat")
            forget.connect("clicked", self.on_forget, address)
            row.add_suffix(forget)
            run_async(["bluetoothctl", "info", address],
                      lambda c, o, b=button, r=row: self.got_info(o, b, r))
            self.devices.add(row)
            self.device_rows.append(row)
        if not self.device_rows:
            row = Adw.ActionRow(title="No devices yet", subtitle="Put your device in pairing mode, then click Search.")
            self.devices.add(row)
            self.device_rows.append(row)

    def got_info(self, out, button, row):
        connected = re.search(r"Connected:\s*yes", out) is not None
        button.set_label("Disconnect" if connected else "Connect")
        row.set_subtitle("Connected" if connected else "Not connected")

    def on_switch(self, *_):
        if self.updating:
            return
        run_async(["bluetoothctl", "power", "on" if self.switch.get_active() else "off"],
                  lambda *_: self.refresh())

    def on_scan(self, button):
        button.set_sensitive(False)
        button.set_label("Searching…")

        def done(*_):
            button.set_sensitive(True)
            button.set_label("Search")
            self.refresh()
        run_async(["bluetoothctl", "--timeout", "10", "scan", "on"], done, timeout=20)

    def on_connect(self, button, address, name):
        if button.get_label() == "Disconnect":
            run_async(["bluetoothctl", "disconnect", address], lambda *_: self.refresh())
            return
        toast(self, f"Connecting to {name}…")
        script = f"bluetoothctl pair {address}; bluetoothctl trust {address}; bluetoothctl connect {address}"

        def done(code, out):
            ok = "Connection successful" in out or code == 0
            toast(self, f"Connected to {name}" if ok else f"Couldn't connect to {name}")
            self.refresh()
        run_async(["sh", "-c", script], done, timeout=60)

    def on_forget(self, button, address):
        run_async(["bluetoothctl", "remove", address], lambda *_: self.refresh())


