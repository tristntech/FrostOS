# --------------------------------------------------------------------------
# Small helpers
# --------------------------------------------------------------------------

def run(cmd, timeout=15):
    """Runs a command and returns (exit code, output). Never raises."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout or "") + (p.stderr or "" if p.returncode else "")
    except FileNotFoundError:
        return 127, f"{cmd[0]} is not installed"
    except subprocess.TimeoutExpired:
        return 124, f"{cmd[0]} took too long"


def run_async(cmd, callback=None, timeout=60):
    """Runs a command in the background, then calls callback(code, output) on the UI thread."""
    def worker():
        code, out = run(cmd, timeout)
        if callback:
            GLib.idle_add(lambda: (callback(code, out), False)[1])
    threading.Thread(target=worker, daemon=True).start()


def have(program):
    return shutil.which(program) is not None


def load_config():
    for path in (CONFIG_FILE, DEFAULT_CONFIG):
        try:
            with open(path) as f:
                return json.load(f)
        except (OSError, ValueError):
            continue
    return {}


def save_config(**changes):
    """Updates ~/.config/frostde/settings.json. The FrostDE shell picks it up at once."""
    data = load_config()
    data.update(changes)
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tmp = CONFIG_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=4)
    os.replace(tmp, CONFIG_FILE)


def write_text(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def gsettings(schema, key, value):
    run_async(["gsettings", "set", schema, key, value])


def hypr_eval(lua):
    """Applies a Hyprland setting right away (it is also saved to a file by the caller)."""
    run_async(["hyprctl", "eval", lua])


def lua_string(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def read_file(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def human_size(n):
    for unit in ("bytes", "KB", "MB", "GB", "TB"):
        if n < 1000 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "bytes" else f"{n:.1f} {unit}"
        n /= 1000
    return str(n)


def icon_box(icon_name, color):
    """A white symbol on a colored rounded square, like in macOS System Settings."""
    img = Gtk.Image.new_from_icon_name(icon_name)
    img.set_pixel_size(16)
    img.add_css_class("frost-icon")
    img.add_css_class(color)
    img.set_valign(Gtk.Align.CENTER)
    return img


def toast(widget, text):
    win = widget.get_root()
    if isinstance(win, SettingsWindow):
        win.toasts.add_toast(Adw.Toast.new(text))


def info_row(title, subtitle):
    row = Adw.ActionRow(title=title, subtitle=subtitle or "—")
    row.add_css_class("property")
    row.set_subtitle_selectable(True)
    return row


def status_page(icon, title, description):
    return Adw.StatusPage(icon_name=icon, title=title, description=description)


