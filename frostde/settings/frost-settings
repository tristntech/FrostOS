class SettingsWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Frost Settings")
        self.set_default_size(980, 680)
        self.set_size_request(360, 400)

        self.toasts = Adw.ToastOverlay()
        self.split = Adw.NavigationSplitView()
        self.split.set_min_sidebar_width(220)
        self.split.set_max_sidebar_width(260)
        self.toasts.set_child(self.split)
        self.set_content(self.toasts)

        # Sidebar
        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.list.add_css_class("navigation-sidebar")
        self.list.set_header_func(self.sidebar_header)
        self.rows = {}
        for page_id, title, icon, color, _cls, section in PAGES:
            row = Gtk.ListBoxRow()
            row.page_id = page_id
            row.section = section
            box = Gtk.Box(spacing=10, margin_top=4, margin_bottom=4, margin_start=4)
            box.append(icon_box(icon, color))
            box.append(Gtk.Label(label=title, xalign=0))
            row.set_child(box)
            self.list.append(row)
            self.rows[page_id] = row
        self.list.connect("row-selected", self.on_row)

        sidebar_view = Adw.ToolbarView()
        sidebar_header = Adw.HeaderBar()
        sidebar_header.set_show_title(False)
        sidebar_view.add_top_bar(sidebar_header)
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroller.set_child(self.list)
        sidebar_view.set_content(scroller)
        self.split.set_sidebar(Adw.NavigationPage(title="Settings", child=sidebar_view))

        # Content
        self.content_view = Adw.ToolbarView()
        self.content_header = Adw.HeaderBar()
        self.content_view.add_top_bar(self.content_header)
        self.content_page = Adw.NavigationPage(title="Settings", child=self.content_view)
        self.split.set_content(self.content_page)

        # Collapse to one column on narrow windows
        bp = Adw.Breakpoint.new(Adw.BreakpointCondition.parse("max-width: 600sp"))
        bp.add_setter(self.split, "collapsed", True)
        self.add_breakpoint(bp)

    @staticmethod
    def sidebar_header(row, before):
        if before is not None and before.section != row.section:
            row.set_header(Gtk.Separator(margin_top=6, margin_bottom=6))
        else:
            row.set_header(None)

    def on_row(self, listbox, row):
        if row is not None:
            self.build_page(row.page_id)
            self.split.set_show_content(True)

    def show_page(self, page_id):
        row = self.rows.get(page_id) or self.rows["wifi"]
        if self.list.get_selected_row() is row:
            self.build_page(row.page_id)      # rebuild to show changes
        else:
            self.list.select_row(row)

    def build_page(self, page_id):
        for pid, title, _icon, _color, cls, _section in PAGES:
            if pid == page_id:
                try:
                    page = cls()
                except Exception as e:  # never let one broken page take down the app
                    page = Adw.PreferencesPage()
                    group = Adw.PreferencesGroup()
                    group.add(Adw.ActionRow(title=f"This page couldn't load", subtitle=str(e)))
                    page.add(group)
                self.content_page.set_title(title)
                self.content_view.set_content(page)
                return


class SettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.add_main_option("page", 0, GLib.OptionFlags.NONE, GLib.OptionArg.STRING,
                             "Open a page: " + ", ".join(p[0] for p in PAGES), "PAGE")
        self.window = None

    def do_startup(self):
        Adw.Application.do_startup(self)
        display = Gdk.Display.get_default()
        if display is None:
            print("Frost Settings needs a graphical desktop to run.", file=sys.stderr)
            sys.exit(1)
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS.decode())
        Gtk.StyleContext.add_provider_for_display(display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        quit_action = Gio.SimpleAction.new("quit", None)
        quit_action.connect("activate", lambda *_: self.quit())
        self.add_action(quit_action)
        self.set_accels_for_action("app.quit", ["<Control>q", "<Super>q"])

    def do_command_line(self, command_line):
        options = command_line.get_options_dict().end().unpack()
        if self.window is None:
            self.window = SettingsWindow(self)
        self.window.show_page(options.get("page") or "wifi")
        self.window.present()
        return 0


if __name__ == "__main__":
    sys.exit(SettingsApp().run(sys.argv))
