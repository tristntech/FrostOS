        motion.connect("notify::active", lambda r, *_: save_config(reduceMotion=r.get_active()))
        mode.add(motion)

        self.add_wallpapers(cfg)

    def on_mode(self, *_):
        save_config(appearance="dark" if self.mode_row.get_selected() == 1 else "light")

    def on_accent(self, button, name, color, gnome, gtk_bg, gtk_fg):
        save_config(accent=color)
        gsettings("org.gnome.desktop.interface", "accent-color", gnome)
        css_path = os.path.join(HOME, ".config", "gtk-4.0", "gtk.css")
        css = read_file(css_path) or read_file("/usr/share/frostde/gtk/gtk4.css")
        css = re.sub(r"(@define-color accent_bg_color )#[0-9A-Fa-f]{6}", rf"\g<1>{gtk_bg}", css)
        css = re.sub(r"(@define-color accent_color )#[0-9A-Fa-f]{6}", rf"\g<1>{gtk_fg}", css)
        css = re.sub(r"(--accent-bg-color: )#[0-9A-Fa-f]{6}", rf"\g<1>{gtk_bg}", css)
        css = re.sub(r"(:root \{\s*--accent-bg-color: [^;]+;\s*--accent-color: )#[0-9A-Fa-f]{6}", rf"\g<1>{gtk_fg}", css)
        write_text(css_path, css)
        toast(self, f"Accent color: {name}. Open apps update the next time they start.")
        self.get_root().show_page("appearance")

    def add_wallpapers(self, cfg):
        group = Adw.PreferencesGroup(title="Wallpaper")
        self.add(group)
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=3,
                           column_spacing=12, row_spacing=12, homogeneous=True)
        pictures = []
        if os.path.isdir(WALLPAPER_DIR):
            pictures = sorted(os.path.join(WALLPAPER_DIR, f) for f in os.listdir(WALLPAPER_DIR)
                              if f.lower().endswith((".png", ".jpg", ".jpeg", ".webp")))
        light = cfg.get("wallpaperLight")
        for path in pictures:
            pic = Gtk.Picture.new_for_filename(path)
            pic.set_content_fit(Gtk.ContentFit.COVER)
            pic.set_size_request(160, 90)
            pic.add_css_class("frost-wallpaper")
            if path == light:
                pic.add_css_class("frost-wallpaper-selected")
            button = Gtk.Button(child=pic, tooltip_text=os.path.basename(path))
            button.add_css_class("flat")
            button.connect("clicked", self.on_wallpaper, path)
            flow.append(button)
        group.add(flow)

        choose = Adw.ButtonRow(title="Choose a Picture…")
        choose.connect("activated", self.on_choose)
        group.add(choose)

    def on_wallpaper(self, button, path):
        # The FrostOS wallpapers come in pairs (…-light / …-dark); use the pair if there is one.
        dark = path.replace("-light", "-dark")
        light = path.replace("-dark", "-light")
        save_config(wallpaperLight=light if os.path.exists(light) else path,
                    wallpaperDark=dark if os.path.exists(dark) else path)
        self.get_root().show_page("appearance")

    def on_choose(self, *_):
        dialog = Gtk.FileDialog(title="Choose a Wallpaper")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        images = Gtk.FileFilter(name="Pictures")
        images.add_mime_type("image/*")
        filters.append(images)
        dialog.set_filters(filters)

        def done(d, result):
            try:
                f = d.open_finish(result)
            except GLib.Error:
                return
            if f and f.get_path():
                save_config(wallpaperLight=f.get_path(), wallpaperDark=f.get_path())
                self.get_root().show_page("appearance")
        dialog.open(self.get_root(), None, done)


