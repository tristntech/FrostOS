#!/usr/bin/env bash
# Take a screenshot, save it in ~/Pictures/Screenshots and copy it.
#   frostde-screenshot screen   the whole screen (Super+Shift+3)
#   frostde-screenshot area     choose an area   (Super+Shift+4)
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/Screenshot $(date '+%Y-%m-%d at %H.%M.%S').png"
case "${1:-area}" in
    screen) grim "$file" || exit 1 ;;
    area)   geometry="$(slurp)" || exit 0; grim -g "$geometry" "$file" || exit 1 ;;
    *)      echo "usage: frostde-screenshot screen|area" >&2; exit 2 ;;
esac
wl-copy --type image/png < "$file"
notify-send --app-name=Screenshot --icon="$file" "Screenshot saved" "${file##*/}"
